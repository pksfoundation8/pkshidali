# ── Sanity ───────────────────────────────────────────────────────────
# Leave these unset and the site runs entirely on the seed content in
# src/content/. Nothing breaks; the CMS is additive.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only. Needs Editor permissions so /api/tributes can create pending
# tributes. NEVER prefix this with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# Server-only. Viewer token. The dataset is provisioned PRIVATE so contributor
# emails are not world-readable, which means reads need a token too. Without
# this the site silently falls back to the seed content in src/content/.
SANITY_API_READ_TOKEN=

# Shared secret for the publish webhook at /api/revalidate.
SANITY_REVALIDATE_SECRET=


# ── Phase 3 hardening ────────────────────────────────────────────────
# Set both before the site is publicised. With them unset the form still
# works and the honeypot + rate limit still apply.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Moderator notification. Without these a submission is still stored as
# pending — the email is a convenience, not the record.
RESEND_API_KEY=
MODERATOR_NOTIFY_EMAIL=
NOTIFY_FROM_EMAIL=

# ── Payments (Phase 4) ───────────────────────────────────────────────
# Naira routes to Paystack; all other currencies route to Flutterwave.
# Unset, /give shows the builder and returns a clear "not switched on yet"
# message rather than pretending to take money.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Enquiry routing. Falls back to CONTACT_NOTIFY_EMAIL for volunteers.
CONTACT_NOTIFY_EMAIL=
VOLUNTEER_NOTIFY_EMAIL=

# ── Gesture counters (candles, flowers, doves, hearts) ───────────────
# Vercel KV / Upstash Redis. REQUIRED on Vercel: its filesystem is read-only,
# so without these the gesture buttons fail. Locally, leave unset and counts
# persist to .data/gestures.json. Vercel's KV integration sets both names
# automatically; UPSTASH_REDIS_REST_URL / _TOKEN are accepted as aliases.
KV_REST_API_URL=
KV_REST_API_TOKEN=
